# ---------------------------------------------------------------------------
# Production domain. Drives every canonical, og:url, the sitemap and robots.
# Getting this wrong tells Google the real page lives on another domain and
# de-indexes the site -- which is exactly what happened when it read
# cruzelectric.com while the site was served from electricbycruz.com.
# Leave blank to use the correct default in app/lib/site.js.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# Copy to .env.local for local development. NEVER commit .env.local
# (.gitignore already covers .env*.local).

# ---------------------------------------------------------------------------
# Admin photo manager (/admin) -- server-only, never sent to the browser.
# Generate all three with:  npm run admin:hash "your-password"
# ---------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Vercel Blob store. Vercel > Storage > Blob > create, then copy the token.
# Injected automatically on Vercel deployments; only needed locally.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Live Google reviews (optional). Both must be set or the widget renders
# nothing and the curated testimonials stand alone.
#
# NEXT_PUBLIC_ means these ARE visible in the browser -- that is unavoidable
# for a Maps key. Protect it by restricting the key in Google Cloud Console to:
#   - HTTP referrers: cruzelectric.com/*, www.cruzelectric.com/*, localhost:3000/*
#   - APIs: Maps JavaScript API only
# Without those restrictions anyone can lift the key and spend your quota.
#
# PLACE ID, not a CID. The business CID 03545373047881462406 will NOT work
# here -- convert it to a ChIJ... Place ID first and confirm the listing is
# Cruz Electric before using it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACE_ID=
